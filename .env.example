# Copy to `.env` and fill in. `.env` is gitignored.

# ── Spelling check ───────────────────────────────────────────────────────────
# Two ways to reach Groq. Use the proxy for anything you deploy.

# THE ONE TO DEPLOY WITH. The /exec URL of the Apps Script Web App from
# google-apps-script/ — the same deployment the ratings use. The Groq key lives
# in its Script Properties, so the browser never sees it.
# Setup: google-apps-script/README-SETUP.md
VITE_SPELLCHECK_PROXY=

# LOCAL DEVELOPMENT ONLY. A Groq key given to the app directly.
# It is inlined into the client bundle at build time and is therefore readable
# by anyone who opens devtools on the deployed site. Never ship a build made
# with this set — use the proxy above.
VITE_GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-20b. Only applies to the direct key;
# through the proxy the model is set in Code.gs.
VITE_GROQ_MODEL=

# ── Ratings ──────────────────────────────────────────────────────────────────
# Optional. Overrides the rating endpoint baked into src/lib/config.ts.
VITE_RATING_ENDPOINT=
