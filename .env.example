# Copy to `.env` and fill in. `.env` is gitignored.

# Groq Cloud key for the Arabic/English spelling check.
# Without it the feature disables itself and the settings row says so.
# NOTE: this is inlined into the client bundle at build time and is therefore
# public on the deployed site. Use a proxy if that matters to you.
VITE_GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-20b.
VITE_GROQ_MODEL=

# Optional. Overrides the rating endpoint baked into src/lib/config.ts.
VITE_RATING_ENDPOINT=
